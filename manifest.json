{
  "manifest_version": 3,
  "name": "Arc Bits",
  "version": "1.3.0",
  "description": "Arc-style tab habits for Chrome: rename tabs, copy URL, move to group, sweep and auto-archive ungrouped tabs.",
  "permissions": ["scripting", "tabs", "tabGroups", "storage", "alarms", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Arc Bits — click to restore last closed batch"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "copy-url": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Copy current tab URL"
    },
    "rename-tab": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Rename current tab"
    },
    "move-to-group": {
      "suggested_key": { "default": "Ctrl+Shift+G", "mac": "Command+Shift+G" },
      "description": "Move current tab to a group"
    },
    "close-ungrouped": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Close all ungrouped tabs in this window"
    }
  }
}
